[
   {don_erleone, 
    [
      {ollama_model, "${OLLAMA_MODEL}"},
      {ollama_url, "${OLLAMA_URL}"},
      {mcp_url, "${MCP_URL}"},
      {timeout, ${TIMEOUT}},
      {sub_model, "${SUB_MODEL}"},
      {sub_timeout, ${SUB_TIMEOUT}}
    ]
   },
   {os_mon, [
      {start_memsup, false},
      {start_disksup, false},
      {start_cpu_sup, false}
   ]},
   {mnesia, [{dir, "${MNESIA_DIR}"}]},
   {kernel, [
       {logger_level, info},
       {logger, [
           {handler, default, logger_std_h, #{
               formatter => {logger_formatter, #{
                   single_line => true,
                   template => [time, " [", level, "] ", msg, "\n"]
               }}
           }}
       ]}
   ]},
   {sasl, [{sasl_error_logger, false}]}
].