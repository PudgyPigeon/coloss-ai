{erl_opts, [debug_info]}.

{deps, [{cowboy, "2.10.0"}, {jsx, "3.1.0"}]}.

{relx,
 [{release, {hello_api, "0.1.0"}, [hello_api, cowboy, sasl, jsx]},
  {dev_mode, false},
  {include_erts, true},
  {extended_start_script, true}]}.

{plugins, [rebar3_format, rebar3_vendor]}.

{shell, [{apps, [hello_api]}]}.
