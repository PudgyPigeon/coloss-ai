# Default command: list all available recipes
default:
    @just --list

# Run the Clojure API
run:
    clj -M -m git-api.core

# Start a development REPL
repl:
    clj

# Check if code is formatted correctly
fmt-check:
    clj -M:format check

# Fix code formatting in-place
fmt-fix:
    clj -M:format fix

# Clean up the .cpcache directory
clean:
    rm -rf .cpcache/ .nrepl-port .shadow-cljs/