# Rig Brain Configuration

# MANDATORY: OpenAI API Key (or a dummy value if using a local proxy)
OPENAI_API_KEY=sk-placeholder-repo-setup

# Optional: Port for the Axum server (default: 3000)
PORT=3000

# Optional: Enable subagent delegation mode (true/false)
ENABLE_SUBAGENTS=false

# Models for different layers (e.g., llama3, mistral, or gpt-4o)
BRAIN_MODEL=llama3
SUBAGENT_MODEL=phi3

# OpenAI Base URL: Point this to Ollama's local API
# For local Ollama, use: http://localhost:11434/v1
OPENAI_API_BASE=http://localhost:11434/v1
